with "config/aa_stm32_config.gpr";
with "aa_stm32_drivers.gpr";

project Aa_Stm32 is

   for Runtime ("Ada") use "light-tasking-" & Aa_Stm32_Drivers.MCU;

   for Target use "arm-eabi";
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Aa_Stm32_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("aa_stm32.adb");

   package Compiler is
      for Default_Switches ("Ada") use Aa_Stm32_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,--defsym=__stack_size=0x2000");
   end Linker;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "st-util";
   end Ide;

end Aa_Stm32;
