{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build aa_stm32 example",
            "type": "shell",
            "command": "alr build",
            "problemMatcher": ["$ada"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Flash aa_stm32 with ST-Util",
            "type": "shell",
            "command": "alr exec -- arm-eabi-objcopy -O binary bin/aa_stm32 bin/aa_stm32.bin && st-flash --connect-under-reset write bin/aa_stm32.bin 0x08000000",
            "problemMatcher": []
        },
        {
            "label": "Flash aa_stm32 with OpenOCD",
            "type": "shell",
            "command": "alr exec -- arm-eabi-objcopy -O binary bin/aa_stm32 bin/aa_stm32.bin && openocd -f interface/stlink.cfg -f target/stm32f4x.cfg -c 'program bin/aa_stm32.bin verify reset exit 0x08000000'",
            "problemMatcher": []
        }
    ]
}