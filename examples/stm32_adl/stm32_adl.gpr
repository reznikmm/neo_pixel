with "config/stm32_adl_config.gpr";
project Stm32_Adl is
   for Runtime ("Ada") use "light-tasking-stm32f4";
   for Target use "arm-eabi";

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Stm32_Adl_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("stm32_adl.adb");

   package Compiler is
      for Default_Switches ("Ada") use Stm32_Adl_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--gc-sections");
   end Linker;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      --  for Connection_Tool use "st-util";
      for Connection_Tool use "openocd";
      for Connection_Config_File use "openocd.cfg";
   end Ide;

end Stm32_Adl;
